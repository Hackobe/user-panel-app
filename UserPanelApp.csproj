<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>1d76d9ba-6649-4cd5-9494-871ee265bb50</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.33">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.33" />
    </ItemGroup>

    <ItemGroup>
        <!-- The test project lives below the web project directory. -->
        <Compile Remove="UserPanelApp.Tests/**/*.cs" />
        <Content Remove="UserPanelApp.Tests/**" />
        <None Remove="UserPanelApp.Tests/**" />
    </ItemGroup>

</Project>
